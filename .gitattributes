# Normalize line endings: LF in the repository, native in the working tree.
# Development happens on Windows, CI runs on Linux -- this keeps diffs clean.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to stay executable.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Explicit text types
*.cs       text diff=csharp
*.csproj   text
*.slnx     text
*.props    text
*.targets  text
*.json     text
*.yml      text
*.yaml     text
*.md       text
*.ts       text
*.tsx      text
*.css      text
*.html     text

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.xlsm binary
