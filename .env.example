# -----------------------------------------------------------------------------
# Template for the local `.env` file consumed by docker-compose.
#
#   Copy-Item .env.example .env      and then fill in POSTGRES_PASSWORD.
#
# `.env` is git-ignored. Never commit real credentials to this repository.
#
# POSTGRES_PASSWORD is intentionally left EMPTY: `docker compose up` stops with
# an explicit message until you set a value, so the password is a deliberate
# choice rather than an inherited default.
#
# The port is published on 127.0.0.1 only -- the database is not reachable from
# other machines on the network.
#
# The API does NOT read this file. Its connection string comes from .NET User
# Secrets in development -- see README.md.
# -----------------------------------------------------------------------------

POSTGRES_DB=commerceops
POSTGRES_USER=commerceops
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
